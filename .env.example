# Everything is optional: the store runs in demo mode without any of these.

# Absolute URL used in metadata, sitemap, JSON-LD and email links.
SITE_URL=http://localhost:3000

# Analytics — loaded only after the visitor accepts the consent banner.
# If both are set, events go through GTM only (configure the GA4 tag inside GTM).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Order confirmation email via Resend. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Admin. Server-only; the admin area is disabled while either is empty.
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
