# Required for checkout. Matches docker-compose.yml.
DATABASE_URL=postgres://modernstore:modernstore@localhost:5434/modernstore

# Payment gateway. "sandbox" is the only provider: Pix + test cards, nothing is ever charged.
PAYMENT_PROVIDER=sandbox
# Signs sandbox card tokens and webhooks. Optional in dev; required when NODE_ENV=production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANDBOX_SECRET=

# Absolute URL used in metadata, sitemap, JSON-LD and email links.
SITE_URL=http://localhost:3000

# Analytics — loaded only after the visitor accepts the consent banner.
# If both are set, events go through GTM only (configure the GA4 tag inside GTM).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=

# Payment confirmation email via Resend. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Admin. Server-only; the admin area is disabled while either is empty.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
